#!/usr/bin/env python3
"""tasmota - Control Tasmota smart plugs via HTTP API.

Usage:
    tasmota <device> on|off|toggle|status|power
    tasmota list [--full|--quiet]
    tasmota discover

Device mapping is loaded from config/devices.yaml.
"""

import sys
import json
import urllib.request
import urllib.error
import yaml
import os

# Default config path
DEFAULT_CONFIG = os.path.expanduser("~/.config/tasmota/devices.yaml")


def load_devices(config_path=None):
    """Load device mapping from YAML config."""
    path = config_path or DEFAULT_CONFIG
    if not os.path.exists(path):
        print(f"Config not found: {path}", file=sys.stderr)
        print(f"Create it with: tasmota init", file=sys.stderr)
        sys.exit(1)
    with open(path) as f:
        data = yaml.safe_load(f)
    return data.get("devices", {})


def save_devices(devices, config_path=None):
    """Save device mapping to YAML config."""
    path = config_path or DEFAULT_CONFIG
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        yaml.dump({"devices": devices}, f, default_flow_style=False)


def get_device(devices, name):
    """Resolve device by name or IP."""
    if name in devices:
        return name, devices[name]
    # Try IP lookup
    for dev_name, dev_info in devices.items():
        if dev_info.get("ip") == name:
            return dev_name, dev_info
    print(f"Device '{name}' not found. Use 'tasmota list' to see devices.", file=sys.stderr)
    sys.exit(1)


def http_get(ip, path, timeout=10):
    """Make HTTP GET request to Tasmota device."""
    url = f"http://{ip}{path}"
    req = urllib.request.Request(url)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.URLError as e:
        print(f"Error connecting to {ip}: {e}", file=sys.stderr)
        sys.exit(1)


def cmd_on(devices, name):
    """Turn device ON."""
    dev_name, dev = get_device(devices, name)
    relay = dev.get("relay", 1)
    ip = dev["ip"]
    result = http_get(ip, f"/cm?cmnd=Power{relay}=ON")
    print(f"{dev_name} -> ON: {result}")


def cmd_off(devices, name):
    """Turn device OFF."""
    dev_name, dev = get_device(devices, name)
    relay = dev.get("relay", 1)
    ip = dev["ip"]
    result = http_get(ip, f"/cm?cmnd=Power{relay}=OFF")
    print(f"{dev_name} -> OFF: {result}")


def cmd_toggle(devices, name):
    """Toggle device."""
    dev_name, dev = get_device(devices, name)
    relay = dev.get("relay", 1)
    ip = dev["ip"]
    # Get current status
    status = http_get(ip, "/cm?cmnd=Status")
    power = status.get("Status", {}).get("Power", "0")
    new_state = "OFF" if power == "1" else "ON"
    result = http_get(ip, f"/cm?cmnd=Power{relay}={new_state}")
    print(f"{dev_name} -> {new_state}: {result}")


def cmd_status(devices, name):
    """Get device status."""
    dev_name, dev = get_device(devices, name)
    ip = dev["ip"]
    result = http_get(ip, "/cm?cmnd=Status")
    status = result.get("Status", {})
    print(f"=== {dev_name} ({ip}) ===")
    print(f"  Power: {status.get('Power', 'unknown')}")
    print(f"  PowerOnState: {status.get('PowerOnState', 'unknown')}")
    print(f"  Module: {status.get('Module', 'unknown')}")
    print(f"  DeviceName: {status.get('DeviceName', 'unknown')}")
    print(f"  FriendlyName: {status.get('FriendlyName', 'unknown')}")
    print(f"  Topic: {status.get('Topic', 'unknown')}")


def cmd_power(devices, name):
    """Get power consumption data."""
    dev_name, dev = get_device(devices, name)
    ip = dev["ip"]
    try:
        result = http_get(ip, "/cm?cmnd=status%208")
        energy = result.get("StatusSNS", {}).get("ENERGY", {})
        print(f"=== {dev_name} Power ===")
        print(f"  Power: {energy.get('Power', 'N/A')} W")
        print(f"  Voltage: {energy.get('Voltage', 'N/A')} V")
        print(f"  Current: {energy.get('Current', 'N/A')} A")
        print(f"  Today: {energy.get('Today', 'N/A')} Wh")
        print(f"  Yesterday: {energy.get('Yesterday', 'N/A')} Wh")
        print(f"  Total: {energy.get('Total', 'N/A')} Wh")
        print(f"  Factor: {energy.get('Factor', 'N/A')}")
        print(f"  ApparentPower: {energy.get('ApparentPower', 'N/A')} VA")
        print(f"  ReactivePower: {energy.get('ReactivePower', 'N/A')} VAR")
    except Exception:
        print(f"{dev_name} does not report power data.", file=sys.stderr)


def cmd_list(devices, verbose=False, quiet=False):
    """List all devices with live status and energy data."""
    if not devices:
        print("No devices configured.")
        return

    # Gather live data for all devices
    live_data = {}
    for dev_name, dev_info in devices.items():
        ip = dev_info["ip"]
        try:
            # Use status 0 to get everything in one call (fixes relay state bug)
            result = http_get(ip, "/cm?cmnd=status%200")
            status_sts = result.get("StatusSTS", {})
            status_sns = result.get("StatusSNS", {})
            energy = status_sns.get("ENERGY", {})
            power_val = status_sts.get("POWER", "0")
            relay_state = "ON" if power_val == "ON" else "OFF"
            live_data[dev_name] = {
                "status": relay_state,
                "power": energy.get("Power", "N/A"),
                "today": energy.get("Today", "N/A"),
                "yesterday": energy.get("Yesterday", "N/A"),
                "total": energy.get("Total", "N/A"),
                "voltage": energy.get("Voltage", "N/A"),
                "current": energy.get("Current", "N/A"),
                "factor": energy.get("Factor", "N/A"),
                "apparent_power": energy.get("ApparentPower", "N/A"),
                "reactive_power": energy.get("ReactivePower", "N/A"),
                "has_energy": bool(energy),
            }
        except Exception:
            live_data[dev_name] = {
                "status": "N/A",
                "power": "N/A",
                "today": "N/A",
                "yesterday": "N/A",
                "total": "N/A",
                "voltage": "N/A",
                "current": "N/A",
                "factor": "N/A",
                "apparent_power": "N/A",
                "reactive_power": "N/A",
                "has_energy": False,
            }

    if quiet:
        for dev_name, info in devices.items():
            ld = live_data[dev_name]
            print(f"{dev_name} {info['ip']} {ld['status']} {ld['power']}")
    elif verbose:
        print(f"{'Name':<20} {'IP':<18} {'Status':<8} {'Power':<10} {'Today':<10} {'Yesterday':<10} {'Total':<10} {'Voltage':<10} {'Current':<10} {'Factor':<8}")
        print("-" * 116)
        for dev_name, info in devices.items():
            ld = live_data[dev_name]
            print(f"{dev_name:<20} {info['ip']:<18} {ld['status']:<8} {ld['power']:<10} {ld['today']:<10} {ld['yesterday']:<10} {ld['total']:<10} {ld['voltage']:<10} {ld['current']:<10} {ld['factor']:<8}")
    else:
        print(f"{'Name':<20} {'IP':<18} {'Status':<8} {'Power (W)':<12} {'Today (Wh)':<12} {'Total (Wh)':<12}")
        print("-" * 78)
        for dev_name, info in devices.items():
            ld = live_data[dev_name]
            print(f"{dev_name:<20} {info['ip']:<18} {ld['status']:<8} {ld['power']:<12} {ld['today']:<12} {ld['total']:<12}")


def cmd_rename(devices, name, new_name):
    """Rename a device on the Tasmota hardware and update local config."""
    dev_name, dev = get_device(devices, name)
    ip = dev["ip"]
    result = http_get(ip, f"/cm?cmnd=DeviceName%20{new_name}")
    print(f"{dev_name} -> DeviceName '{new_name}': {result}")
    # Update local config
    if dev_name in devices:
        devices[dev_name]["name"] = new_name
        save_devices(devices)
        print(f"  Config updated: {dev_name} renamed to '{new_name}'")
    else:
        # Device found by IP - rename the key
        for key in list(devices.keys()):
            if devices[key].get("ip") == ip:
                devices[new_name] = devices.pop(key)
                devices[new_name]["name"] = new_name
                save_devices(devices)
                print(f"  Config updated: '{key}' renamed to '{new_name}'")
                break


def cmd_updateip(devices, name, new_ip):
    """Update the IP address of a device in local config and on the device."""
    dev_name, dev = get_device(devices, name)
    old_ip = dev["ip"]
    # First, update the device's IP setting on the hardware
    result = http_get(old_ip, f"/cm?cmnd=IP1%20{new_ip}")
    print(f"{dev_name} -> IP1 {new_ip}: {result}")
    # Update local config
    if dev_name in devices:
        devices[dev_name]["ip"] = new_ip
        save_devices(devices)
        print(f"  Config updated: {dev_name} IP changed from {old_ip} to {new_ip}")
    else:
        # Device found by name - update IP
        devices[dev_name]["ip"] = new_ip
        save_devices(devices)
        print(f"  Config updated: {dev_name} IP changed from {old_ip} to {new_ip}")


def cmd_discover():
    """Discover Tasmota devices via UDP broadcast (Tasmota discovery)."""
    # Tasmota uses UDP broadcast on port 1883 for discovery
    # This is a simplified version - full discovery requires parsing JSON payloads
    print("Tasmota discovery requires network scan or MQTT broker access.")
    print("Use 'tasmota list' to see devices.")
    print("Add devices to ~/.config/tasmota/devices.yaml")


def cmd_init():
    """Initialize config file."""
    path = DEFAULT_CONFIG
    os.makedirs(os.path.dirname(path), exist_ok=True)
    sample = {
        "devices": {
            "example_plug": {
                "ip": "192.168.88.XX",
                "relay": 1,
                "has_power_meter": True
            }
        }
    }
    with open(path, "w") as f:
        yaml.dump(sample, f, default_flow_style=False)
    print(f"Config created: {path}")
    print("Edit it to add your devices.")


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)

    cmd = sys.argv[1].lower()

    if cmd == "init":
        cmd_init()
        return

    devices = load_devices()

    if cmd == "list":
        verbose = "--full" in sys.argv
        quiet = "--quiet" in sys.argv
        cmd_list(devices, verbose=verbose, quiet=quiet)
    elif cmd == "discover":
        cmd_discover()
    elif cmd in ("on", "off", "toggle", "status", "power"):
        if len(sys.argv) < 3:
            print(f"Usage: tasmota {cmd} <device>", file=sys.stderr)
            sys.exit(1)
        name = sys.argv[2]
        {
            "on": cmd_on,
            "off": cmd_off,
            "toggle": cmd_toggle,
            "status": cmd_status,
            "power": cmd_power,
        }[cmd](devices, name)
    elif cmd == "rename":
        if len(sys.argv) < 4:
            print("Usage: tasmota rename <device> <new_name>", file=sys.stderr)
            sys.exit(1)
        cmd_rename(devices, sys.argv[2], sys.argv[3])
    elif cmd == "updateip":
        if len(sys.argv) < 4:
            print("Usage: tasmota updateip <device> <new_ip>", file=sys.stderr)
            sys.exit(1)
        cmd_updateip(devices, sys.argv[2], sys.argv[3])
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    main()
